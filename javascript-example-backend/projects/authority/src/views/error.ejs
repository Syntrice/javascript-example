<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 2rem; width: 100%; max-width: 400px; text-align: center; }
    h1 { font-size: 1.5rem; margin-bottom: 1rem; color: #c00; }
    p { color: #666; font-size: 0.875rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= error %></h1>
    <% if (description) { %>
      <p><%= description %></p>
    <% } %>
  </div>
</body>
</html>
